# =============================================================================
# Spotify Configuration
# =============================================================================
# Create a Spotify app at https://developer.spotify.com/dashboard
# See docs/SPOTIFY_SETUP.md for step-by-step instructions.

# Required – Your Spotify application's Client ID (no secret needed for PKCE)
SPOTIFY_CLIENT_ID=your_client_id_here

# Optional – OAuth redirect URI. Spotify requires the loopback IP, not "localhost".
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# =============================================================================
# YouTube Configuration
# =============================================================================
# Create a project at https://console.cloud.google.com
# Enable the YouTube Data API v3, then create an API key.
# See docs/YOUTUBE_SETUP.md for step-by-step instructions.

# Required – YouTube Data API v3 key
YOUTUBE_API_KEY=your_api_key_here

# Optional – Playback mode: 'iframe' (default, official embed) or 'extract' (yt-dlp audio)
YOUTUBE_PLAYBACK_MODE=iframe

# Optional – Google OAuth2 credentials for personal data (liked videos, playlists)
# Create OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Application type: Desktop app
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8889/callback

# =============================================================================
# Jellyfin Configuration
# =============================================================================
# Point this at your Jellyfin server.
# See docs/JELLYFIN_SETUP.md for step-by-step instructions.

# Required – Full URL of your Jellyfin server (include port if non-default)
JELLYFIN_SERVER_URL=http://localhost:8096

# Authentication – provide EITHER username/password OR an API key
JELLYFIN_USERNAME=
JELLYFIN_PASSWORD=
JELLYFIN_API_KEY=

# Optional – Transcoding quality: 'original' (default), 'high', 'medium', 'low'
JELLYFIN_TRANSCODE_QUALITY=original

# Optional – Enable server-side transcoding (default: false)
JELLYFIN_ENABLE_TRANSCODING=false

# Optional – Local cache directory for offline playback
# Defaults to <userData>/jellyfin-cache
JELLYFIN_CACHE_DIRECTORY=

# Optional – Maximum cache size in bytes (default: 5368709120 = 5 GB)
JELLYFIN_MAX_CACHE_SIZE=5368709120

# =============================================================================
# Weather Configuration (OpenWeatherMap)
# =============================================================================
# Sign up at https://openweathermap.org/api and subscribe to the One Call API 3.0.
# Free tier includes 1,000 calls/day.

# Required – OpenWeatherMap API key
WEATHER_API_KEY=your_weather_api_key_here

# Optional – Default location (lat,lon). If empty, uses browser geolocation.
WEATHER_DEFAULT_LAT=
WEATHER_DEFAULT_LON=

# Optional – Temperature unit: 'fahrenheit' (default) or 'celsius'
WEATHER_UNIT=fahrenheit

# =============================================================================
# News Configuration (NewsAPI)
# =============================================================================
# Sign up at https://newsapi.org to get a free API key.
# Free tier: 100 requests/day, headlines only.

# Required – NewsAPI key
NEWS_API_KEY=your_news_api_key_here

# Optional – Default news country code (default: us)
NEWS_COUNTRY=us

# =============================================================================
# Twitter / X  (api.twitter.com v2)
# =============================================================================
# Create an app at https://developer.twitter.com/en/portal/dashboard
# Only a Bearer Token is needed to read public tweets (no OAuth required).

# Required – Twitter API v2 Bearer Token
TWITTER_BEARER_TOKEN=your_bearer_token_here

# =============================================================================
# Unsplash (Dashboard Background)
# =============================================================================
# Sign up at https://unsplash.com/developers and create a new application.
# Free tier: 50 requests/hour (Media Hub caches one image per session, so this
# is more than sufficient for personal use).
# Attribution to the photographer is displayed in the dashboard corner as
# required by Unsplash API guidelines.

# Required – Unsplash API Access Key (the "Access Key", not the Secret Key)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
