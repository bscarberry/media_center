{
  "name": "media-hub",
  "version": "1.0.0",
  "description": "Brandon's Media Hub – Personal media aggregation desktop app",
  "author": "Brandon Scarberry",
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build:main && npm run build:preload && concurrently -n vite,electron \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "lint": "eslint src/ --ext .ts,.tsx",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "type-check:main": "tsc --noEmit -p tsconfig.main.json",
    "type-check:preload": "tsc --noEmit -p tsconfig.preload.json",
    "type-check:all": "npm run type-check && npm run type-check:main && npm run type-check:preload",
    "clean": "rm -rf dist out"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.7.9",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "electron-store": "^8.1.0",
    "express": "^4.18.2",
    "framer-motion": "^12.34.1",
    "howler": "^2.2.4",
    "lucide-react": "^0.469.0",
    "open": "^9.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "^2.2.2",
    "react-player": "^2.16.0",
    "react-router-dom": "^7.13.0",
    "react-window": "^2.2.7",
    "recharts": "^3.7.0",
    "youtube-dl-exec": "^3.0.10",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/howler": "^2.2.11",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/spotify-web-playback-sdk": "^0.1.19",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^28.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.3.0",
    "vite": "^6.0.7",
    "wait-on": "^8.0.3"
  }
}
